# Supabase project (public values — safe in the browser; data is protected by row-level security)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public base URL of this deployment, used in sign-up confirmation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Agent (server only; never prefix with NEXT_PUBLIC_) ---
# Service key for the agent worker (set automatically by Vercel's Supabase integration)
SUPABASE_SERVICE_ROLE_KEY=
# AI message writing
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace (Anthropic Console → Workspaces → ID)
ANTHROPIC_WORKSPACE_ID=
# Optional: model and USD price per million tokens, used for cost tracking
AI_MODEL=claude-sonnet-5-5
AI_PRICE_IN=3
AI_PRICE_OUT=15

# Google Places API (New) — optional second discovery source. Restrict the key to "Places API (New)".
GOOGLE_PLACES_API_KEY=
# USD per Text Search request, for the cost report (Enterprise SKU list price; free monthly usage not deducted)
GOOGLE_PLACES_PRICE=0.035
# Max billed Google requests per mission (cost cap; ~40 × 0.035 = 1.40 USD)
GOOGLE_PLACES_MAX_REQUESTS=40

# Email sending (Resend). The sender domain must be verified in Resend (DNS records at the domain host).
RESEND_API_KEY=
# Default sender; a tenant's "Send from" setting replaces the address.
EMAIL_FROM="Sigen Solar Energy <sales@sigensol.com>"
# Optional: signing key for unsubscribe links (derived from the service key when unset)
UNSUBSCRIBE_SECRET=
# Optional: public URL used in email links (defaults to the Vercel production URL)
APP_URL=
